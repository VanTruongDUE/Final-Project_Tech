# SQL Server SQLAlchemy URL. Do not commit a real connection string.
DATABASE_URL=mssql+pyodbc://SERVER/TechTonicDb?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Generate a random secret of at least 32 characters for each environment.
# Never reuse this placeholder in a deployed environment.
JWT_SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters

PORT=5000
FLASK_ENV=development
FLASK_DEBUG=false

# Development-only escape hatch. Keep false unless a developer explicitly
# needs the OTP in the local API response. OTP values are never logged.
ENABLE_DEV_OTP=false

# Optional, only for Database/db_seed_helpers.py. Use a private value and do
# not print or commit it.
DEMO_SELLER_PASSWORD=replace-with-a-private-demo-seed-password
