# Frontend API base. Vite proxy maps /api to Flask backend during local dev.
VITE_API_BASE_URL=/api/v1

# Use "api" for Phase 1 FE-BE integration.
# Switch to "mock" only when running the frontend standalone.
VITE_DATA_SOURCE=api

# Never expose AI provider keys, database credentials, JWT secrets or other
# server-side secrets through VITE_* variables; Vite embeds them in the bundle.
